# Copy to .env, then edit. docker compose loads it automatically.
#
# Defaults below are tuned for local development with agents:
#   - the host port binds only to 127.0.0.1 (loopback)
#   - kata's default auth mode (trust-client) lets agents identify
#     via ?as=<email> or an API token (`kata token create`)
#
# For any deployment beyond your laptop, set KATA_LISTEN_ADDR=0.0.0.0
# AND a real KATA_AUTH_MODE here. See docs/deploying.md.

# REQUIRED for the default `kata` service. Host directory holding
# your jj repos. Each immediate subdir that's a jj repo becomes a
# workspace (slug = directory name); drop a new repo in and the
# live scanner picks it up within ~200ms.
KATA_WORKSPACES_DIR=/path/to/your/repos

# Pin a specific release image instead of :latest.
# KATA_IMAGE=ghcr.io/martint/kata:1.2.3

# Persistent data directory (sqlite DB + scanner state + any ACME
# cache). Default is a managed Docker volume named `kata-data`; set
# this to a host path to bind-mount instead. Compose doesn't expand
# `~`, so use ${HOME} or an absolute path.
# KATA_DATA_DIR=${HOME}/kata

# Listen address on the host. Defaults to 127.0.0.1 (loopback only).
# Change to 0.0.0.0 ONLY after you've also set a non-default
# KATA_AUTH_MODE — otherwise anyone on the network can impersonate
# anyone via X-Review-Author / ?as=.
# KATA_LISTEN_ADDR=0.0.0.0

# Host port. Default 7878.
# KATA_PORT=7878

# Default writer identity (used when the client doesn't supply one
# via X-Review-Author / ?as= and the auth mode is trust-client).
# KATA_AUTHOR=dev@localhost

# Log verbosity. Default: info,kata=debug for development.
# RUST_LOG=info,kata=debug
