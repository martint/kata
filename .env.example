# Copy to .env, then edit. docker compose loads it automatically.
#
# Defaults below are tuned for local development with agents:
#   - compose publishes kata's port on 127.0.0.1 only (loopback)
#   - kata's default auth mode (trust-client) lets agents identify
#     via ?as=<email> or an API token (`kata token create`)
#
# KATA_PUBLISH_ADDR / KATA_PUBLISH_PORT control the host side of
# compose's port-publish (the HOST_IP:HOST_PORT half of
# HOST_IP:HOST_PORT:CONTAINER_PORT). They do NOT change kata's own
# bind inside the container — that's always 0.0.0.0:7878, set via
# KATA_BIND in the Dockerfile. Renaming HOST-side or container-side
# is a different control.
#
# For any deployment beyond your laptop, set KATA_PUBLISH_ADDR=0.0.0.0
# AND a real KATA_AUTH_MODE here. See docs/deploying.md.

# REQUIRED for the default `kata` service. Host directory holding
# your jj repos. Each immediate subdir that's a jj repo becomes a
# workspace (slug = directory name); drop a new repo in and the
# live scanner picks it up within ~200ms.
KATA_WORKSPACES_DIR=/path/to/your/repos

# Pin a specific release image instead of :latest.
# KATA_IMAGE=ghcr.io/martint/kata:1.2.3

# Persistent data directory (sqlite DB + scanner state + any ACME
# cache). Default is a managed Docker volume named `kata-data`; set
# this to a host path to bind-mount instead. Compose doesn't expand
# `~`, so use ${HOME} or an absolute path.
# KATA_DATA_DIR=${HOME}/kata

# Host interface compose publishes the port-forward on. Defaults
# to 127.0.0.1 (loopback only). Change to 0.0.0.0 ONLY after you've
# also set a non-default KATA_AUTH_MODE — otherwise anyone on the
# network can impersonate anyone via X-Review-Author / ?as=.
# (This is the HOST_IP in compose's HOST_IP:HOST_PORT:CONTAINER_PORT
# mapping; the container's own bind stays 0.0.0.0 either way.)
# KATA_PUBLISH_ADDR=0.0.0.0

# Host port compose publishes on. Default 7878. (The container
# inside always listens on 7878; this only changes the host side.)
# KATA_PUBLISH_PORT=7878

# Default writer identity (used when the client doesn't supply one
# via X-Review-Author / ?as= and the auth mode is trust-client).
# KATA_AUTHOR=dev@localhost

# Hostname(s) to add to MCP's Host-header allowlist (DNS-rebinding
# guard). Default allows localhost / 127.0.0.1 / ::1 only, which is
# fine for same-host access but blocks any public hostname when
# kata sits behind a reverse proxy. Add your hostname(s) here.
# Space-separated for multiple values.
# KATA_MCP_ALLOWED_HOST=kata.example.com

# Log verbosity. Default: info,kata=debug for development.
# RUST_LOG=info,kata=debug
